{
  "name": "mario-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:server & npm run dev:mobile",
    "start": "npm run scan && node server/index.ts",
    "stop": "lsof -ti :4000 | xargs -r kill || true",
    "restart": "npm run stop && npm start",
    "dev:server": "tsx watch server/index.ts",
    "dev:mobile": "cd mobile && npx expo start",
    "build:ios:local": "bash scripts/build-ios-local.sh",
    "seed": "node scripts/seed.ts",
    "scan": "node scripts/scan.ts",
    "loudness": "node scripts/loudness.ts",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts",
    "typecheck": "tsc --noEmit && cd mobile && npm run typecheck",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
